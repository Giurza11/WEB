.navigation {
  @include flex-row-between();
  width: Percent(1440, 1440);
  margin: 0 auto;
  padding-top: 40px;
  padding-left: Percent(38.39, 1440);
  padding-right: Percent(38.39, 1440);

  &__main {
    &-list {
      @include flex-row();

      &-item {
        & a {
          color: black;
          text-decoration: none;
          transition: all 0s ease 5s;

          &::after {
          }

          @keyframes myAnimation2 {
            0% {
              opacity: 0;
            }
            20% {
              opacity: 0.2;
            }
            40% {
              opacity: 0.4;
              background: #000;
            }
            60% {
              opacity: 0.6;
            }
            80% {
              opacity: 0.8;
              background: yellow;
            }
            100% {
              opacity: 1;
            }
          }
        }

        &:hover,
        &--green {
          & a {
            color: #2ebb77;

            &::after {
              margin-left: 5px;
              border-top: 2px solid #2ebb77;
              border-right: 2px solid #2ebb77;
            }
          }
        }
        &:hover {
          & a {
            &::after {
              transform: rotate(270deg) scale(1.75);
            }
          }
        }
      }
    }
  }

  &__logo {
    width: Percent(160, 1363.22);
    margin: 0;

    & img {
      width: 100%;
      display: block;
    }
  }

  &__sidebar {
    display: flex;
    align-items: center;
    gap: 30px;

    &-item {
      border-radius: 12px;
      border: 2px solid #f4eefa;
      width: Percent(101, 1440);
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;

      & img {
        display: block;
      }
    }
  }
}
let fullname = "Furniro Lab";
let age = "16";
let student = true;
document.getElementById("myP1").textContent = `you are ${fullname}`;
document.getElementById("myP2").textContent = ` you are ${age} years old`;
document.getElementById("myP3").textContent = ` embedded: ${student}`;
